---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from './Base.astro';
import { SITE } from '../config';
import { type Lang, t, localizePath } from '../i18n/utils';
import { projectLinks } from '../lib/project-helpers';

interface Props {
  lang: Lang;
  slug: string;
  data: CollectionEntry<'projects'>['data'];
}

const { lang, slug, data } = Astro.props;
const home = localizePath(lang, '/');
const links = projectLinks(data);
const linkLabels = { github: t(lang, 'caseStudy.github'), demo: t(lang, 'caseStudy.demo') };
---

<Base
  lang={lang}
  path={`/progetti/${slug}/`}
  title={`${data.title} — ${SITE.name}`}
  description={data.summary}
  ogImage={data.cover}
>
  <article class="container case">
    <a class="back" href={`${home}#work`}>← {t(lang, 'caseStudy.back')}</a>
    <header>
      <p class="eyebrow">{t(lang, 'work.label')}</p>
      <h1>{data.title}</h1>
      <p class="lead">{data.summary}</p>
      <ul class="tags" aria-label={t(lang, 'caseStudy.stack')}>
        {data.stack.map((item) => <li>{item}</li>)}
      </ul>
      {
        links.length > 0 && (
          <div class="links" data-project-links>
            {links.map((link) => (
              <a class="btn btn-ghost" href={link.url} rel="noopener" data-link={link.kind}>
                {linkLabels[link.kind]} ↗
              </a>
            ))}
          </div>
        )
      }
    </header>
    <Image
      class="cover"
      src={data.cover}
      alt={data.coverAlt}
      widths={[720, 1440]}
      sizes="(min-width: 72rem) 72rem, 100vw"
      loading="eager"
    />
    <div class="prose">
      <slot />
    </div>
    <aside class="cta">
      <h2>{t(lang, 'caseStudy.ctaTitle')}</h2>
      <a class="btn btn-primary" href={`${home}#contact`}>{t(lang, 'caseStudy.cta')}</a>
    </aside>
  </article>
</Base>

<style>
  .case {
    padding-block: var(--space-l) var(--space-xl);
  }
  .back {
    font-size: var(--step--1);
    color: var(--muted);
    text-decoration: none;
  }
  header {
    display: grid;
    gap: var(--space-s);
    max-width: 48rem;
    margin-block: var(--space-l);
  }
  h1 {
    font-size: var(--step-3);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-top: var(--space-xs);
  }
  .case :global(.cover) {
    width: 100%;
    margin-bottom: var(--space-l);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .prose {
    max-width: 42rem;
  }
  .prose :global(h2) {
    margin: var(--space-l) 0 var(--space-s);
    font-size: var(--step-2);
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 var(--space-s);
  }
  .prose :global(li) {
    margin-bottom: 0.3em;
  }
  .prose :global(img) {
    margin-block: var(--space-m);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .prose :global(code) {
    padding: 0.1em 0.35em;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--surface);
    font-size: 0.9em;
  }
  .prose :global(pre) {
    overflow-x: auto;
    padding: var(--space-s);
    border-radius: var(--radius);
  }
  .cta {
    display: grid;
    justify-items: start;
    gap: var(--space-m);
    margin-top: var(--space-xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--line);
  }
  .cta h2 {
    font-size: var(--step-2);
  }
</style>
